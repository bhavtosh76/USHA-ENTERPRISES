# ------------------------------------------------------------------
# USHA ENTERPRISES ERP — environment template
# Copy to .env and fill real values. Never commit .env.
# ------------------------------------------------------------------

# Local SQLite (zero-config). For PostgreSQL see README section 9.
DATABASE_URL="file:./dev.db"

# Signs session JWTs. Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="generate-a-long-random-secret"

# Session lifetime in minutes (480 = 8 hours)
SESSION_MINUTES="480"

# Private upload directory (outside public/). Must be persistent and backed up.
UPLOAD_DIR="./storage/uploads"

# Storage driver: "local" (disk, self-hosted) or "db" (PostgreSQL bytes).
# Use "db" on Firebase / Cloud Run where the filesystem is ephemeral.
STORAGE_DRIVER="local"

# Public site URL used in absolute links/documents
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional seed controls:
# SEED_DEMO="false"            # seed roles/owner/settings only, no demo business data
# SEED_ADMIN_PASSWORD="..."    # override the default owner password at seed time
